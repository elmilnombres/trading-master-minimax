# ============================================================
# TRADING PORTFOLIO SYSTEM — ENVIRONMENT TEMPLATE
# ============================================================
# This is the ONLY secrets template in the repo.
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# NEVER put real secrets in any other file.
#
# For the full secrets file template see:
# docs/00_IMPLEMENTATION_INPUT/07_SECRETS_LOCAL_ONLY.env
# (input package — never copied into the repo)
# ============================================================

# ===========================================================
# BOT IDENTITY
# Set BOT_NAME and SUBACCOUNT_NAME via docker-compose or
# environment — do not put real credentials here.
# ===========================================================
BOT_NAME=alpha_bot
SUBACCOUNT_NAME=BYBIT_ALPHA

# ===========================================================
# BYBIT — filled by setup_subaccounts.py or manually
# ===========================================================
BYBIT_API_KEY=REPLACE_WITH_REAL_KEY
BYBIT_API_SECRET=REPLACE_WITH_REAL_SECRET

# ===========================================================
# EXCHANGE ENVIRONMENT
# ===========================================================
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_TESTNET=false

# ===========================================================
# PATHS (Coolify mounts — do not change)
# ===========================================================
STATE_DIR=/app/state
LOGS_DIR=/app/logs
JOURNALS_DIR=/app/data/journals
CACHE_DIR=/app/data/cache

# ===========================================================
# ALERTING
# ===========================================================
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_REAL_CHAT_ID
WEBHOOK_SECRET=REPLACE_WITH_REAL_WEBHOOK_SECRET

# ===========================================================
# LOGGING
# ===========================================================
LOG_LEVEL=INFO
APP_TIMEZONE=America/Argentina/Buenos_Aires